# Cloudflare Workers static assets read this file from the build output.
# Astro fingerprints everything under /_astro/, so it can be cached for a year
# and never revalidated. Pages (and sw.js) keep Cloudflare's default,
# public, max-age=0, must-revalidate, which is right for HTML and the service worker.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
