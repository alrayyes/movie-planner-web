{
  "name": "movie-planner-web",
  "version": "0.58.0",
  "private": true,
  "description": "Public CalDAV-backed web client for movie-planner, deployed to Cloudflare Workers.",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "astro check",
    "deploy": "wrangler deploy",
    "dev": "astro dev",
    "format": "biome check --write .",
    "format:check": "prettier --check \"**/*.{md,yml,yaml,astro}\"",
    "lint": "biome check .",
    "lint:md": "markdownlint-cli2",
    "lint:mechanics": "./scripts/lint-mechanics.sh",
    "lint:prose": "./scripts/lint-prose.sh",
    "prepare": "lefthook install || true",
    "preview": "wrangler dev --port 4321",
    "sort-package-json": "sort-package-json",
    "sort-package-json:check": "sort-package-json --check",
    "test": "bun run test:unit && bun run test:e2e",
    "test:e2e": "playwright test",
    "test:integration": "bun test test/integration",
    "test:integration:down": "docker compose -f test/integration/compose.yaml down",
    "test:integration:up": "docker compose -f test/integration/compose.yaml up -d --wait && ./test/integration/provision-baikal.sh",
    "test:unit": "bun test src"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.0",
    "@astrojs/svelte": "9.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.1",
    "fuzzball": "2.2.6",
    "leaflet": "1.9.4",
    "postal-mime": "3.0.0",
    "svelte": "5.57.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.8",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@playwright/test": "1.62.1",
    "@types/leaflet": "1.9.22",
    "bun-types": "1.4.1",
    "lefthook": "2.1.10",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "sort-package-json": "4.0.0",
    "typescript": "6.0.3",
    "wrangler": "4.125.0"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "lefthook"
  ]
}
