{
  "name": "movie-planner-web",
  "version": "1.34.3",
  "private": true,
  "description": "Public CalDAV-backed web client for movie-planner, deployed to Cloudflare Workers.",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "astro check",
    "deploy": "wrangler deploy",
    "dev": "astro dev",
    "format": "biome check --write .",
    "format:check": "prettier --check \"**/*.{md,yml,yaml,astro}\"",
    "lighthouse": "bun scripts/lighthouse.ts",
    "lint": "biome check .",
    "lint:claude": "./scripts/lint-claude.sh",
    "lint:md": "markdownlint-cli2",
    "lint:mechanics": "./scripts/lint-mechanics.sh",
    "lint:prose": "./scripts/lint-prose.sh",
    "lint:tailwind": "oxlint",
    "mutation": "stryker run",
    "prepare": "lefthook install || true",
    "preview": "wrangler dev --port 4321",
    "screenshots": "SCREENSHOTS=1 ./scripts/in-private-network.sh playwright test tests/page-gallery.spec.ts",
    "sort-package-json": "sort-package-json",
    "sort-package-json:check": "sort-package-json --check",
    "test": "bun run test:unit && bun run test:e2e",
    "test:e2e": "./scripts/in-private-network.sh playwright test",
    "test:integration": "bun test test/integration",
    "test:integration:down": "docker compose -f test/integration/compose.yaml down",
    "test:integration:up": "docker compose -f test/integration/compose.yaml up -d --wait && ./test/integration/provision-baikal.sh",
    "test:unit": "bun test src scripts --reporter=junit --reporter-outfile=coverage/junit-unit.xml"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "katex": "0.18.2",
    "postcss-selector-parser": "7.1.6",
    "qs": "6.16.0",
    "re2js": "2.8.7",
    "sharp": "0.35.5",
    "smol-toml": "1.9.0",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.8",
    "@astrojs/svelte": "9.1.2",
    "@codecov/astro-plugin": "2.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.4",
    "fuzzball": "2.2.6",
    "leaflet": "1.9.4",
    "svelte": "5.57.3",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@felixgeelhaar/cclint": "0.25.0",
    "@hughescr/stryker-bun-runner": "1.6.0",
    "@playwright/test": "1.64.1",
    "@shadcn/lint": "0.2.3",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@types/leaflet": "1.9.22",
    "bun-types": "1.4.4",
    "fake-indexeddb": "6.2.7",
    "happy-dom": "21.0.4",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.0",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sort-package-json": "4.1.0",
    "typescript": "6.0.3",
    "wrangler": "4.156.1"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "lefthook"
  ]
}
