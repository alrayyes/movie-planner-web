---
import "../styles/global.css";

interface Props {
  title: string;
}

// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      // Runs before body paint, deliberately not a module (those defer)
      // — a visitor's explicit choice, or the OS default until they've
      // made one, has to land before first paint or there's a visible
      // flash of the wrong theme. <theme-toggle> (loaded later, as a
      // regular component) only reflects and changes this from here on.
      try {
        var stored = localStorage.getItem("movie-planner-web-theme");
        var dark = stored
          ? stored === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      } catch (_e) {}
    </script>
  </head>
  <body>
    <div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
      <header class="mb-6 flex items-center justify-between">
        <a
          href="/"
          class="text-lg font-semibold tracking-tight text-slate-900 hover:text-indigo-600 dark:text-slate-100 dark:hover:text-indigo-400"
        >
          Movie Planner
        </a>
        <theme-toggle></theme-toggle>
      </header>
      <main
        class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6 dark:border-slate-700 dark:bg-slate-800"
      >
        <slot />
      </main>
    </div>
    <script>
      import "../components/theme-toggle";
    </script>
  </body>
</html>
