---
// biome-ignore lint/correctness/noUnusedImports: used in the template below the frontmatter fence, which Biome does not parse for .astro files
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";

interface Props {
  title: string;
  // #65: the calendar overview and movie details page (poster + full
  // metadata) are cramped at the shared 768px form width every other
  // page (log, import, settings, credentials gate) is deliberately kept
  // at — those stay narrow since a form column that wide starts feeling
  // like scanning a spreadsheet.
  wide?: boolean;
}

// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
const { title, wide = false } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      // Runs before body paint, deliberately not a module (those defer)
      // — a visitor's explicit choice, or the OS default until they've
      // made one, has to land before first paint or there's a visible
      // flash of the wrong theme. <theme-toggle> (loaded later, as a
      // regular component) only reflects and changes this from here on.
      try {
        var stored = localStorage.getItem("movie-planner-web-theme");
        var dark = stored
          ? stored === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      } catch (_e) {}
    </script>
  </head>
  <body>
    <div class="gh-ribbon">
      <a
        href="https://github.com/alrayyes/movie-planner-web"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-indigo-600 text-white shadow-[0_3px_10px_rgb(0,0,0,0.15)] hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-400"
      >
        Fork me on GitHub
      </a>
    </div>
    <div
      id="page-container"
      class:list={[
        "mx-auto px-4 py-8 sm:px-6 lg:px-8",
        wide ? "max-w-6xl" : "max-w-3xl",
      ]}
    >
      <header class="mb-6 flex items-center justify-between">
        <a
          href="/"
          class="text-lg font-semibold tracking-tight text-slate-900 hover:text-indigo-600 dark:text-slate-100 dark:hover:text-indigo-400"
        >
          Movie Planner
        </a>
        <theme-toggle></theme-toggle>
      </header>
      <main
        class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6 dark:border-slate-700 dark:bg-slate-800"
      >
        <slot />
      </main>
      <SiteFooter />
    </div>
    <script>
      import "../components/theme-toggle";
    </script>
  </body>
</html>
