---
// #451: extracted out of Layout.astro so the same header can also be
// rendered inside Starlight's own page frame
// (src/components/starlight/Header.astro, wired in via astro.config.mjs's
// `starlight({ components: { Header: ... } })`) — a docs page gets this
// app's own chrome instead of Starlight's default title/search/theme-select
// bar, same as every other page. The Web Components mounted below
// (site-nav, log-viewing-button, keyboard-nav, theme-toggle) behave
// identically wherever this is rendered — including site-nav's own
// credentials gate, so a docs page shows no nav links either until a
// visitor has connected, exactly like everywhere else.
//
// #603: the log wizard's own <dialog> needs somewhere on the page to live. #920:
// it isn't mounted here any more — log-viewing-button.ts imports and mounts it
// into this persisted placeholder on the first click, so no page pays for the
// wizard's code until someone logs a viewing.
---

<header class="mb-6 flex items-center justify-between max-[640px]:flex-wrap max-[640px]:gap-y-2">
  <a
    href="/"
    class="flex items-center gap-2 whitespace-nowrap text-lg font-semibold tracking-tight text-slate-900 hover:text-indigo-600 dark:text-slate-100 dark:hover:text-indigo-400"
  >
    <!-- #434: the same mark as favicon.svg, inlined rather than
    reused via `<img src="/favicon.svg">` — its own fill switches
    on the OS-level `prefers-color-scheme` media query, which is
    right for a browser tab icon but wrong here: this app's dark
    mode is a class on <html> toggled by the in-page switch
    (global.css's `@custom-variant dark`), independent of the OS
    setting, so an <img> reuse would go illegible the moment a
    visitor's manual choice disagrees with their OS preference.
    `fill-current` ties the mark to the same `text-*`/`dark:text-*`
    (and hover) classes already on this link instead. -->
    <svg
      viewBox="0 0 128 128"
      class="h-7 w-7 shrink-0 fill-current"
      aria-hidden="true"
    >
      <rect x="24" y="70" width="64" height="34" rx="6"></rect>
      <g transform="rotate(-14 22 58)">
        <rect x="20" y="48" width="72" height="18" rx="4"></rect>
      </g>
    </svg>
    Movie Planner
  </a>
  <!-- #677: before connecting, log-viewing-button and keyboard-nav render
  nothing, but an empty flex item still takes a gap beside the theme
  toggle — hide the empty ones so the layout closes up. -->
  <div class="header-actions flex items-center gap-2 [&>*:empty]:hidden">
    <keyboard-nav></keyboard-nav>
    <log-viewing-button></log-viewing-button>
    <theme-toggle></theme-toggle>
  </div>
</header>
<!-- Empty until the script runs, then a one-line nav (20px of links, 16px
padding, 1px border, 24px margin). Reserve that height so <main> doesn't
jump down when it appears. -->
<site-nav class="block empty:min-h-[3.8125rem]"></site-nav>
<div data-log-wizard-root transition:persist="log-wizard-root"></div>

<script>
  import "./keyboard-nav";
  import "./log-viewing-button";
  import "./site-nav";
  import "./theme-toggle";
</script>
