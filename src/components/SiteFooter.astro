---
// #67: extracted out of Layout.astro for the same reason washy-washy-web's
// own SiteFooter is — it's the one piece of chrome every page repeats
// verbatim, and a plain nested <footer> reads worse inline in the layout
// than as its own named piece.
---

<footer
  class="mt-10 border-t border-slate-200 pt-6 text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400"
>
  <div class="flex flex-col items-center gap-2 text-center">
    <div class="flex flex-wrap justify-center gap-x-4 gap-y-1">
      <a
        href="https://github.com/alrayyes/movie-planner-web"
        class="underline decoration-slate-300 underline-offset-2 hover:text-indigo-600 hover:decoration-indigo-600 dark:decoration-slate-600 dark:hover:text-indigo-400 dark:hover:decoration-indigo-400"
      >
        GitHub
      </a>
      <a
        href="/disclaimer"
        class="underline decoration-slate-300 underline-offset-2 hover:text-indigo-600 hover:decoration-indigo-600 dark:decoration-slate-600 dark:hover:text-indigo-400 dark:hover:decoration-indigo-400"
      >
        Disclaimer
      </a>
      <a
        href="/privacy"
        class="underline decoration-slate-300 underline-offset-2 hover:text-indigo-600 hover:decoration-indigo-600 dark:decoration-slate-600 dark:hover:text-indigo-400 dark:hover:decoration-indigo-400"
      >
        Privacy
      </a>
    </div>
    <p class="max-w-md text-xs">
      &copy; {new Date().getFullYear()} the movie-planner-web contributors. Licensed
      <a
        href="https://github.com/alrayyes/movie-planner-web/blob/main/LICENSE"
        class="underline decoration-slate-300 underline-offset-2 hover:text-indigo-600 hover:decoration-indigo-600 dark:decoration-slate-600 dark:hover:text-indigo-400 dark:hover:decoration-indigo-400"
      >
        GPL-3.0-or-later
      </a>.
    </p>
  </div>
</footer>
