---
// biome-ignore lint/correctness/noUnusedImports: used in the template below the frontmatter fence, which Biome does not parse for .astro files
import ActivityLog from "../components/ActivityLog.svelte";
// biome-ignore lint/correctness/noUnusedImports: used in the template below the frontmatter fence, which Biome does not parse for .astro files
import Layout from "../layouts/Layout.astro";
---

<Layout title="Activity — Movie Planner" wide>
  <h1
    class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100"
  >
    Activity
  </h1>
  <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
    A local record of what this app itself has done to your calendar — stored
    only in this browser, not synced anywhere, and not a record of anything the
    CLI does on its own.
  </p>
  <div class="mt-6">
    {
      /* #349: client:only, not client:load — reads IndexedDB on mount,
      which doesn't exist during the static build (no `indexedDB` global
      in Node), same reason every other browser-storage-reading island
      here already uses client:only. */
    }
    <ActivityLog client:only="svelte" />
  </div>
</Layout>
