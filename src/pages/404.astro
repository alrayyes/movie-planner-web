---
// biome-ignore lint/correctness/noUnusedImports: used in the template below the frontmatter fence, which Biome does not parse for .astro files
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found — Movie Planner">
  <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
    Page not found
  </h1>
  <div class="mt-6 flex flex-col gap-4 text-slate-700 dark:text-slate-300">
    <p>There's nothing at this address. The link may be old, or mistyped.</p>
    <p>
      <a class="text-indigo-600 underline dark:text-indigo-400" href="/">
        Back to the calendar
      </a>
    </p>
  </div>
</Layout>
