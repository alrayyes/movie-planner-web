---
// #369: `?raw` inlines the file's text content at build time — a plain
// fs.readFileSync of a relative path resolves against the bundled
// chunk's own location once Astro moves this page's code into
// dist/.prerender/, not against the source tree, and 404s at build
// time (confirmed live: ENOENT for dist/CHANGELOG.md).
import changelogMarkdown from "../../CHANGELOG.md?raw";
// biome-ignore lint/correctness/noUnusedImports: used in the template below the frontmatter fence, which Biome does not parse for .astro files
import Layout from "../layouts/Layout.astro";
import { parseChangelog } from "../lib/changelog/parse";

// #369: parsed from the same CHANGELOG.md release-please already
// maintains with real versions and dates, filtered to end-user-relevant
// entries — see parse.ts for why this beats a hand-maintained second
// list.
// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
const releases = parseChangelog(changelogMarkdown);

// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
function scopeLabel(scope: string): string {
  return scope.replace(/-/g, " ");
}
---

<Layout title="Changelog — Movie Planner">
  <h1
    class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100"
  >
    Changelog
  </h1>
  <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
    What's changed, and when — internal changes (dependency bumps, CI, tests)
    are left out.
  </p>
  <div class="mt-6 flex flex-col gap-8">
    {
      releases.length === 0 ? (
        <p class="text-sm text-slate-600 dark:text-slate-400">
          Nothing to show yet.
        </p>
      ) : (
        releases.map((release) => (
          <section>
            <h2 class="flex flex-wrap items-baseline gap-x-3 text-lg font-semibold text-slate-900 dark:text-slate-100">
              <span>v{release.version}</span>
              <time
                datetime={release.date}
                class="text-sm font-normal text-slate-500 dark:text-slate-400"
              >
                {release.date}
              </time>
            </h2>
            <ul class="mt-2 flex flex-col gap-1.5 pl-5">
              {release.entries.map((entry) => (
                <li class="list-disc text-slate-700 dark:text-slate-300">
                  <span class="text-xs font-medium tracking-wide text-slate-500 uppercase dark:text-slate-400">
                    {scopeLabel(entry.scope)}
                  </span>{" "}
                  {entry.description}{" "}
                  <a
                    href={entry.prUrl}
                    class="text-xs text-slate-500 underline decoration-slate-300 underline-offset-2 hover:text-indigo-600 hover:decoration-indigo-600 dark:text-slate-400 dark:decoration-slate-600 dark:hover:text-indigo-400 dark:hover:decoration-indigo-400"
                  >
                    #{entry.prNumber}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      )
    }
  </div>
</Layout>
