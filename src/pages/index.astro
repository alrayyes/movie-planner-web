---
// biome-ignore lint/correctness/noUnusedImports: used in the template below the frontmatter fence, which Biome does not parse for .astro files
import Layout from "../layouts/Layout.astro";
---

<Layout title="movie-planner-web">
  <h1 class="text-2xl font-bold tracking-tight text-slate-900">
    movie-planner-web
  </h1>
  <p class="mt-2 text-sm text-slate-600">
    A public web client for <a
      class="font-medium text-indigo-600 hover:underline"
      href="https://github.com/alrayyes/movie-planner">movie-planner</a
    >, reading and writing straight to your own CalDAV calendar.
  </p>
  <div class="mt-6">
    <credentials-gate></credentials-gate>
  </div>
</Layout>

<script>
  import "../components/credentials-gate";
</script>
