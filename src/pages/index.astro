---
// biome-ignore lint/correctness/noUnusedImports: used in the template below the frontmatter fence, which Biome does not parse for .astro files
import Layout from "../layouts/Layout.astro";
---

<Layout title="Movie Planner" wide>
  <h1 class="sr-only">Movie Planner</h1>
  <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
    A public web client for{" "}
    <a
      class="font-medium text-indigo-600 hover:underline dark:text-indigo-400"
      href="https://github.com/alrayyes/movie-planner"
    >
      movie-planner
    </a>
    , reading and writing straight to your own CalDAV calendar.
  </p>
  <div class="mt-6">
    <!-- Empty until the script runs, then the connect form (about 750px tall
         on a phone, 550px on desktop). Reserve that height so the footer
         doesn't jump when it appears. -->
    <credentials-gate class="block empty:min-h-[46rem] sm:empty:min-h-[34rem]"></credentials-gate>
  </div>
</Layout>

<script>
  import "../components/credentials-gate";
</script>
