---
// biome-ignore lint/correctness/noUnusedImports: used in the template below the frontmatter fence, which Biome does not parse for .astro files
import GlobalMap from "../components/GlobalMap.svelte";
// biome-ignore lint/correctness/noUnusedImports: used in the template below the frontmatter fence, which Biome does not parse for .astro files
import Layout from "../layouts/Layout.astro";
---

<Layout title="Map — Movie Planner">
  <h1
    class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100"
  >
    Map
  </h1>
  <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
    Every logged viewing whose venue has known coordinates, pinned on one map —
    click a pin for its title, or the movie's own details page for the exact
    location.
  </p>
  <div class="mt-6">
    {
      /* #8/#203: client:only, not client:load — reads stored
      credentials on mount, which doesn't exist during the static
      build (see VenuesOverview's own identical note). This replaces
      #237's static preview now that movie-planner#170's real
      coordinates exist to plot. */
    }
    <GlobalMap client:only="svelte" />
  </div>
</Layout>
