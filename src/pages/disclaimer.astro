---
// biome-ignore lint/correctness/noUnusedImports: used in the template below the frontmatter fence, which Biome does not parse for .astro files
import Layout from "../layouts/Layout.astro";
---

<Layout title="Disclaimer — Movie Planner">
  <h1
    class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100"
  >
    Disclaimer
  </h1>
  <div class="mt-6 flex flex-col gap-4 text-slate-700 dark:text-slate-300">
    <div
      class="rounded-lg border border-amber-300 bg-amber-50 p-4 text-amber-900 dark:border-amber-700 dark:bg-amber-950 dark:text-amber-100"
      role="note"
    >
      <p class="font-semibold">Use at your own risk.</p>
      <p class="mt-2">
        This is beta software, not yet fully tested. It reads, writes, and
        deletes events directly on the CalDAV server you point it at — set up a
        calendar dedicated to your movie viewings rather than pointing it at one
        you also use for anything else, so a bug here can't touch anything that
        matters.
      </p>
    </div>
    <p>
      movie-planner-web is an independent hobby project. It isn't affiliated
      with, endorsed by, or sponsored by OMDb, IMDb, Rotten Tomatoes,
      Metacritic, Letterboxd, Pathé, or any CalDAV server vendor. Any product
      names, logos, and brands mentioned are the property of their respective
      owners.
    </p>
    <p>
      This site relies on your own OMDb API key and your own CalDAV server — it
      doesn't provision, guarantee, or take responsibility for either. Only
      Baikal has been tested against so far; another CalDAV server may or may
      not work correctly.
    </p>
    <p>
      This software is provided as-is, without warranty of any kind, per the
      terms of the GPL-3.0-or-later licence it's distributed under. The
      maintainers aren't responsible for data loss, corruption, or any other
      issue arising from using it.
    </p>
  </div>
</Layout>
